NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=fl_copilot
MONGODB_MAX_POOL_SIZE=20
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_CODE_PEPPER=replace-with-at-least-32-random-characters
# Local development only. Never configure this in production.
AUTH_DEVELOPMENT_CODE=123456
# Production: keep the Resend key server-side and use an address on a verified domain.
# RESEND_API_KEY=re_replace_with_a_restricted_sending_key
# AUTH_EMAIL_FROM=connexion@auth.example.com
