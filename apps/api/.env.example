NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Server-only Sentry project. Do not reuse the mobile DSN.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# SENTRY_ENVIRONMENT=development
# Enable only while verifying M0-T10, then remove or set to false.
# SENTRY_TEST_ROUTE_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=fl_copilot
MONGODB_MAX_POOL_SIZE=20
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_CODE_PEPPER=replace-with-at-least-32-random-characters
# Local development only. Never configure this in production.
AUTH_DEVELOPMENT_CODE=123456
# Production: keep the Resend key server-side and use an address on a verified domain.
# RESEND_API_KEY=re_replace_with_a_restricted_sending_key
# AUTH_EMAIL_FROM=connexion@auth.example.com

# Optional inbound reception; keep the send-only authentication key separate.
# Resend currently requires full_access for received-attachment reads. Obtain owner approval.
# Store the dedicated credential as a production Secret, never in a native/public variable.
# Legacy installations may reuse RESEND_API_KEY if it already has receiving access.
# RESEND_RECEIVING_API_KEY=re_replace_with_an_approved_receiving_key
# RESEND_RECEIVING_DOMAIN=your-managed-domain.resend.app
# RESEND_RECEIVING_WEBHOOK_SECRET=whsec_replace_with_the_webhook_signing_secret

# Installed via the Inngest Vercel integration; server only.
# Both keys enable signed /api/inngest callbacks and PDF page processing.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Optional model override for new commercial drafts, via the existing AI Gateway.
# COMMERCIAL_PDF_AI_MODEL=openai/gpt-6.1-sol

# Copilot generation (remote only; explicit OpenAI model required before rollout).
# Reuses OPENAI_API_KEY. No new key is necessary.
# COPILOT_AI_MODEL=<configured-openai-model-id>
# COPILOT_AI_TIMEOUT_MS=90000
# COPILOT_AI_MAX_OUTPUT_TOKENS=4000
# COPILOT_AI_MAX_INPUT_BYTES=524288
