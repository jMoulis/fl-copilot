{
  "name": "@fl-copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/runtime.ts",
    "dev:ensure-store": "tsx --env-file-if-exists=.env src/development/ensure-store.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/runtime.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fl-copilot/analytics-core": "workspace:*",
    "@fl-copilot/domain": "workspace:*",
    "@fl-copilot/import-core": "workspace:*",
    "@fl-copilot/sync-contracts": "workspace:*",
    "@sentry/node": "^11.0.0",
    "@vercel/blob": "^2.3.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "heic-convert": "^2.1.0",
    "mongodb": "^6.20.0",
    "resend": "6.30.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fl-copilot/test-fixtures": "workspace:*",
    "@types/heic-convert": "^2.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
