{
  "name": "@fl-copilot/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist/web-preview",
    "preview:web": "serve -s dist/web-preview -l tcp://127.0.0.1:8087"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@fl-copilot/sync-contracts": "workspace:*",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "nativewind": "4.2.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.63.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.0",
    "tailwindcss": "^3.4.17",
    "serve": "14.2.6"
  }
}
