{
  "name": "@fl-copilot/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist/web-preview",
    "preview:web": "serve -s dist/web-preview -l tcp://127.0.0.1:8087",
    "eas:config:development": "pnpm dlx eas-cli@24.8.0 config --platform ios --profile development --non-interactive",
    "eas:config:staging": "pnpm dlx eas-cli@24.8.0 config --platform ios --profile staging --non-interactive",
    "eas:config:production": "pnpm dlx eas-cli@24.8.0 config --platform ios --profile production --non-interactive",
    "eas:build:development": "pnpm dlx eas-cli@24.8.0 build --profile development"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "^15.0.2",
    "@fl-copilot/api-client": "workspace:*",
    "@fl-copilot/sync-contracts": "workspace:*",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.63.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.17"
  }
}
