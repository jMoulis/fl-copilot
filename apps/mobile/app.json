{
  "expo": {
    "name": "Fruits & Légumes",
    "slug": "fruits-vegetables-copilot",
    "version": "0.1.0",
    "scheme": "flcopilot",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flcopilot.mobile",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": ["fr"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.flcopilot.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      "expo-system-ui",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Fruits & Légumes à photographier les tickets de casse.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Fruits & Légumes à choisir une photo de ticket de casse.",
          "cameraPermission": "Autoriser Fruits & Légumes à photographier les tickets de casse.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "moulis",
          "project": "fruits-et-legumes"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser Fruits & Légumes à relever ponctuellement la position du magasin.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0073c570-07c3-49f0-a7ad-8148ae536bbe"
      }
    },
    "owner": "julesmoulis"
  }
}
