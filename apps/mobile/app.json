{
  "expo": {
    "name": "Fruits & Légumes",
    "slug": "fruits-vegetables-copilot",
    "version": "0.1.0",
    "scheme": "flcopilot",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flcopilot.mobile",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": ["fr"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.flcopilot.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      "expo-system-ui",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0073c570-07c3-49f0-a7ad-8148ae536bbe"
      }
    },
    "owner": "julesmoulis"
  }
}
